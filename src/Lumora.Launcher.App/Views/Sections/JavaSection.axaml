<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumora.Launcher.App.ViewModels"
             xmlns:java="using:Lumora.Launcher.Core.Java"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Lumora.Launcher.App.Views.Sections.JavaSection"
             x:DataType="vm:GameSettingsEditorViewModel">
    <Border Classes="section">
        <StackPanel Spacing="4">
            <Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h3" Text="Своя Java" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Выключено — лаунчер сам скачает подходящую Java для версии игры. Это рекомендуемый вариант." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJava}" OnContent="" OffContent="" />
            </Grid>

            <StackPanel Spacing="12" IsVisible="{Binding UseCustomJava}">
                <Separator Classes="thin" />
                <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="Путь к java" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding JavaPath}" PlaceholderText="C:\Program Files\Java\jdk-21\bin\javaw.exe" FontFamily="{StaticResource Lumora.Mono}" FontSize="12.5" />
                        <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseJavaCommand}" />
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="muted" Text="{Binding DetectResult}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Command="{Binding DetectJavaCommand}" IsEnabled="{Binding !IsDetecting}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
                            <TextBlock Text="Найти установленные" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox ItemsSource="{Binding DetectedJavas}" SelectedItem="{Binding SelectedJava}"
                         IsVisible="{Binding DetectedJavas.Count}" Background="Transparent" MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="java:JavaInstallation">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="pill accent" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock Text="{Binding Major, StringFormat=Java {0}}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="Medium">
                                        <Run Text="{Binding Version}" />
                                        <Run Text="·" Foreground="{DynamicResource Lumora.TextMuted}" />
                                        <Run Text="{Binding Vendor}" Foreground="{DynamicResource Lumora.TextSecondary}" />
                                    </TextBlock>
                                    <TextBlock Classes="muted" Text="{Binding Executable}" TextTrimming="PathSegmentEllipsis" FontFamily="{StaticResource Lumora.Mono}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
