<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumora.Launcher.App.ViewModels"
             x:Class="Lumora.Launcher.App.Views.Sections.GameSection"
             x:DataType="vm:GameSettingsEditorViewModel">
    <StackPanel Spacing="16">
        <Border Classes="section">
            <StackPanel>
                <Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h3" Text="Размер окна игры" />
                        <TextBlock Classes="muted" Text="Ширина и высота при запуске в оконном режиме." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown Value="{Binding WindowWidth}" Minimum="640" Maximum="7680" Increment="10" Width="120" FormatString="0" IsEnabled="{Binding !Fullscreen}" />
                        <TextBlock Text="×" VerticalAlignment="Center" Classes="secondary" />
                        <NumericUpDown Value="{Binding WindowHeight}" Minimum="480" Maximum="4320" Increment="10" Width="120" FormatString="0" IsEnabled="{Binding !Fullscreen}" />
                    </StackPanel>
                </Grid>
                <Separator Classes="thin" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h3" Text="Полноэкранный режим" />
                        <TextBlock Classes="muted" Text="Запускать игру сразу на весь экран." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Fullscreen}" OnContent="" OffContent="" />
                </Grid>
                <Separator Classes="thin" />
                <Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h3" Text="Сразу заходить на сервер" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="После загрузки игра подключится к серверу без главного меню." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnect}" OnContent="" OffContent="" />
                </Grid>
            </StackPanel>
        </Border>

        <Expander Header="Для продвинутых: команды запуска" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14" Margin="0,4,0,4">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="Команда-обёртка" />
                    <TextBlock Classes="muted" Text="Запускает Java через другую программу, например gamemoderun или prime-run." />
                    <TextBox Text="{Binding WrapperCommand}" FontFamily="{StaticResource Lumora.Mono}" FontSize="12.5" PlaceholderText="gamemoderun" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="Перед запуском" />
                    <TextBox Text="{Binding PreLaunchCommand}" FontFamily="{StaticResource Lumora.Mono}" FontSize="12.5" PlaceholderText="Команда выполнится до старта игры" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="После выхода" />
                    <TextBox Text="{Binding PostExitCommand}" FontFamily="{StaticResource Lumora.Mono}" FontSize="12.5" PlaceholderText="Команда выполнится после закрытия игры" />
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
