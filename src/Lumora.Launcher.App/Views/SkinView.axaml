<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumora.Launcher.App.ViewModels"
             xmlns:c="using:Lumora.Launcher.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Lumora.Launcher.App.Views.SkinView"
             x:DataType="vm:SkinViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="32,4,32,20" Spacing="4">
            <TextBlock Classes="h1" Text="Скин" />
            <TextBlock Classes="secondary" Text="Так вас увидят другие игроки на серверах Lumora." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="32,0,32,28">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24" VerticalAlignment="Top">
                <!-- Preview -->
                <Border Classes="card" Width="300" Padding="0">
                    <Grid RowDefinitions="*,Auto">
                        <Border Height="400" Background="{DynamicResource Lumora.SurfaceSunken}" CornerRadius="14,14,0,0">
                            <Panel>
                                <c:SkinPreview Skin="{Binding Skin}" Slim="{Binding IsSlim}" Margin="40,36"
                                               Mode="Front" IsVisible="{Binding !ShowBack}"
                                               PlaceholderBrush="{DynamicResource Lumora.BorderStrong}" />
                                <c:SkinPreview Skin="{Binding Skin}" Slim="{Binding IsSlim}" Margin="40,36"
                                               Mode="Back" IsVisible="{Binding ShowBack}"
                                               PlaceholderBrush="{DynamicResource Lumora.BorderStrong}" />
                            </Panel>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="h2" Text="{Binding PlayerName}" />
                                <TextBlock Classes="muted" Text="Вид спереди" IsVisible="{Binding !ShowBack}" />
                                <TextBlock Classes="muted" Text="Вид сзади" IsVisible="{Binding ShowBack}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon" Command="{Binding FlipCommand}" ToolTip.Tip="Повернуть">
                                <mi:MaterialIcon Kind="Rotate3dVariant" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
                    <Border Classes="section">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="h3" Text="Загрузить новый скин" />
                                <TextBlock Classes="muted" TextWrapping="Wrap" Text="PNG размером 64×64 (или старый формат 64×32). Скин появится в игре после перезахода на сервер." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Command="{Binding UploadCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="Upload" Width="18" Height="18" />
                                        <TextBlock Text="Выбрать файл" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenOnSiteCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="OpenInNew" Width="17" Height="17" />
                                        <TextBlock Text="Открыть на сайте" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="h3" Text="Модель" />
                                <TextBlock Classes="muted" Text="Толщина рук персонажа." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <RadioButton GroupName="model" IsChecked="{Binding IsClassic}" Content="Классическая (4 px)" />
                                <RadioButton GroupName="model" IsChecked="{Binding IsSlim}" Content="Тонкая (3 px)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
