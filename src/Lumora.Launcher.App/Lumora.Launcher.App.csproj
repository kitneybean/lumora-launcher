<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Lumora</AssemblyName>
    <RootNamespace>Lumora.Launcher.App</RootNamespace>
    <Version>0.1.1</Version>
    <ApplicationIcon>Assetsumora.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Auth server the launcher connects to out of the box: -p:LumoraAuthServer=https://auth.example.com -->
  <PropertyGroup>
    <LumoraAuthServer Condition="'$(LumoraAuthServer)' == ''">https://mc.4ntares.ru</LumoraAuthServer>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LumoraAuthServer" Value="$(LumoraAuthServer)" />
  </ItemGroup>

  <!-- Release builds bake in the GitHub repository used for self-update: -p:LumoraUpdateRepo=owner/name -->
  <ItemGroup Condition="'$(LumoraUpdateRepo)' != ''">
    <AssemblyMetadata Include="LumoraUpdateRepo" Value="$(LumoraUpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumora.Launcher.Core\Lumora.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
