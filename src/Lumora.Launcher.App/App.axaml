<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Lumora.Launcher.App.App"
             xmlns:local="using:Lumora.Launcher.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Lumora/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#3DD68C" RegionColor="#0D0F13" />
                <ColorPaletteResources x:Key="Light" Accent="#18A35E" RegionColor="#F4F6F8" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <mi:MaterialIconStyles />
        <StyleInclude Source="avares://Lumora/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
